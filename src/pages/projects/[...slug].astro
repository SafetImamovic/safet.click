---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import KofiButton from "../../components/KofiButton.astro";
import Icon from "../../components/Icon.astro";
import { getProjects } from "../../lib/content";
import { iconFor } from "../../consts";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, status, kind, stack, repo, demo, links, image, imageAlt, kofi } = project.data;
---

<Base title={title} description={description}>
  <article class="section">
    <a href="/projects" class="back mono">← projects</a>
    <h1>{title}</h1>
    {kind && <p class="eyebrow">{kind}</p>}
    <p class="lead muted">{description}</p>
    <div class="btn-row">
      {
        demo && (
          <a class="btn primary" href={demo}>
            <Icon name="live" /> Open live
          </a>
        )
      }
      {
        repo && (
          <a class="btn" href={repo}>
            <Icon name="github" /> Source
          </a>
        )
      }
      {
        links.map((l) => (
          <a class="btn" href={l.href}>
            <Icon name={iconFor(l.label)} /> {l.label}
          </a>
        ))
      }
    </div>
    <p class="meta mono muted">status: {status}</p>
    <div>{stack.map((s) => <span class="tag">{s}</span>)}</div>
    {image && <img class="hero" src={image} alt={imageAlt ?? ""} />}
    <div class="prose">
      <Content />
    </div>
    {
      kofi && (
        <div class="support">
          <p>Enjoying the mod? It's free and MIT licensed. A coffee keeps updates coming.</p>
          <KofiButton />
        </div>
      )
    }
  </article>
</Base>

<style>
  .back {
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
  }
  h1 {
    margin-top: 1rem;
  }
  .lead {
    font-size: 1.1rem;
  }
  .meta {
    font-size: 0.8rem;
    margin: 0 0 0.5rem;
  }
  .hero {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin-top: 1.5rem;
  }
  .support {
    margin-top: 3rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }
  .support p {
    margin: 0 0 0.75rem;
  }
</style>

---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { getProjects } from "../../lib/content";
import { LINKS } from "../../consts";

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const rest = projects.filter((p) => !p.data.featured);
---

<Base title="Projects" description="Products, Minecraft mods, render engines, research and tools I've built.">
  <section class="section">
    <h1>Projects</h1>
    <p class="muted">
      Products, Minecraft mods, render engines, research and tools. The rest lives on <a href={LINKS.github}>GitHub</a>.
    </p>
  </section>

  <section class="section">
    <div class="section-head"><h2>Featured</h2></div>
    <div class="grid">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>More</h2></div>
    {rest.map((p) => <ProjectRow project={p} />)}
  </section>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: 1rem;
  }
</style>

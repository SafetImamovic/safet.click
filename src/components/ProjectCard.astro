---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { title, description, status, stack, image, imageAlt, kind } = project.data;
---

<a class="card" href={`/projects/${project.id}/`}>
  {image && <img src={image} alt={imageAlt ?? ""} loading="lazy" />}
  <div class="body">
    <div class="top">
      <h3>{title}</h3>
      <span class={`status ${status}`}>{status}</span>
    </div>
    {kind && <p class="kind mono">{kind}</p>}
    <p class="muted">{description}</p>
    <div>{stack.slice(0, 5).map((s) => <span class="tag">{s}</span>)}</div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.15s, transform 0.15s;
  }
  .card:hover {
    color: inherit;
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .body {
    padding: 1.1rem 1.25rem;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  h3 {
    margin: 0;
    font-size: 1.05rem;
  }
  .kind {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    color: var(--accent);
  }
  p {
    margin: 0.4rem 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }
  .status {
    font-family: var(--mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    white-space: nowrap;
  }
  .status::before {
    content: "●";
    margin-right: 0.35rem;
  }
  .status.active::before {
    color: #22c55e;
  }
  .status.shipped::before {
    color: #3b82f6;
  }
  .status.paused::before {
    color: #eab308;
  }
</style>

---
import { SITE, SOCIALS } from "../consts";
---

<footer class="container">
  <span>© {new Date().getFullYear()} {SITE.author}</span>
  <span class="links">
    {SOCIALS.map((s) => <a href={s.href}>{s.name}</a>)}
    <a href="/rss.xml">RSS</a>
  </span>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  a {
    color: var(--muted);
  }
</style>

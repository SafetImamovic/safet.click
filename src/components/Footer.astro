---
import Icon from "./Icon.astro";
import { SITE, SOCIALS } from "../consts";
---

<footer class="container">
  <span>© {new Date().getFullYear()} {SITE.author}</span>
  <span class="links">
    {
      SOCIALS.map((s) => (
        <a href={s.href} aria-label={s.name} title={s.name}>
          <Icon name={s.icon} size={18} />
        </a>
      ))
    }
    <a href="/rss.xml" class="mono rss">RSS</a>
  </span>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 5rem;
    padding-top: 1.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  a {
    color: var(--muted);
    display: inline-flex;
  }
  a:hover {
    color: var(--accent);
  }
  .rss {
    font-size: 0.8rem;
  }
</style>

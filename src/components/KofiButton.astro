---
import Icon from "./Icon.astro";
import { LINKS } from "../consts";

interface Props {
  label?: string;
}

const { label = "Support my mods on Ko-fi" } = Astro.props;
---

<a class="kofi" href={LINKS.kofi}><Icon name="kofi" size={18} /> {label}</a>

<style>
  .kofi {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    background: #ff5e5b;
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .kofi:hover {
    color: #fff;
    filter: brightness(1.08);
  }
</style>
